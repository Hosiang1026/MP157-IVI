set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(DEFINED ENV{CC} AND NOT "$ENV{CC}" STREQUAL "")
    set(CMAKE_C_COMPILER "$ENV{CC}" CACHE FILEPATH "" FORCE)
endif()
if(DEFINED ENV{CXX} AND NOT "$ENV{CXX}" STREQUAL "")
    set(CMAKE_CXX_COMPILER "$ENV{CXX}" CACHE FILEPATH "" FORCE)
endif()
if(DEFINED ENV{AR} AND NOT "$ENV{AR}" STREQUAL "")
    set(CMAKE_AR "$ENV{AR}" CACHE FILEPATH "" FORCE)
endif()
if(DEFINED ENV{STRIP} AND NOT "$ENV{STRIP}" STREQUAL "")
    set(CMAKE_STRIP "$ENV{STRIP}" CACHE FILEPATH "" FORCE)
endif()

if(DEFINED ENV{OECORE_TARGET_SYSROOT} AND NOT "$ENV{OECORE_TARGET_SYSROOT}" STREQUAL "")
    set(CMAKE_SYSROOT "$ENV{OECORE_TARGET_SYSROOT}")
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{OECORE_TARGET_SYSROOT}")
endif()

if(DEFINED ENV{IVI_QT6_DIR} AND NOT "$ENV{IVI_QT6_DIR}" STREQUAL "")
    list(APPEND CMAKE_PREFIX_PATH "$ENV{IVI_QT6_DIR}")
    if(EXISTS "$ENV{IVI_QT6_DIR}/lib/cmake/Qt6")
        list(APPEND CMAKE_PREFIX_PATH "$ENV{IVI_QT6_DIR}/lib/cmake/Qt6")
    endif()
endif()

if(DEFINED ENV{OECORE_NATIVE_SYSROOT} AND EXISTS "$ENV{OECORE_NATIVE_SYSROOT}/usr")
    set(QT_HOST_PATH "$ENV{OECORE_NATIVE_SYSROOT}/usr" CACHE PATH "")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_CROSSCOMPILING TRUE)
