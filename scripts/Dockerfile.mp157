FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    curl \
    ca-certificates \
    git \
    python3 \
    python3-pip \
    python3-venv \
    xz-utils \
    unzip \
    pkg-config \
    libgl1-mesa-dev \
    libglib2.0-dev \
    libfontconfig1-dev \
    libfreetype-dev \
    libxkbcommon-dev \
    libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages aqtinstall

WORKDIR /work
COPY setup-wsl-mp157.sh /usr/local/bin/setup-mp157.sh
RUN chmod +x /usr/local/bin/setup-mp157.sh

ENV IVI_WSL_ROOT=/opt/mp157-dev
ENV IVI_PROJ=/work/proj
ENV PATH=/root/.local/bin:$PATH

CMD ["/usr/local/bin/setup-mp157.sh", "all"]
